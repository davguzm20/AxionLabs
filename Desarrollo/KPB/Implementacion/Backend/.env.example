# Copiar como .env y completar con los datos de Neon
# (Connect > rama develop > rol kpb_app > "Parameters only").
# Todas son obligatorias. El archivo .env no se sube al repositorio.
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=
PGCHANNELBINDING=

# Autenticacion (tambien obligatorias)
# JWT_SECRET: minimo 32 caracteres aleatorios. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# REDIS_URL: Upstash > base Redis > "Connect" (usa rediss://, con TLS)
REDIS_URL=
