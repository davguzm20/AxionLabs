# Copiar como .env y completar con los datos de Neon
# (Connect > rama develop > rol kpb_app > "Parameters only").
# Todas son obligatorias. El archivo .env no se sube al repositorio.
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=
PGCHANNELBINDING=

# Origenes permitidos por CORS, separados por comas. En produccion incluye la
# URL de Vercel; por ejemplo:
CORS_ORIGINS=

# Autenticacion (tambien obligatorias)
# JWT_SECRET: minimo 32 caracteres aleatorios. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# REDIS_URL: Upstash > base Redis > "Connect" (usa rediss://, con TLS)
REDIS_URL=

# Optional: enables OpenAI for text and image extraction/classification.
# Voice transcription remains simulated until the STT adapter is implemented.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1