# URL base de la API; incluir /api/v1. Sustituir por el host real al conectar el backend.
VITE_API_BASE_URL=https://axionlabs-oclp.onrender.com

# MSW del navegador está desactivado: en desarrollo se usa la API configurada.
# Los mocks se ejecutan únicamente dentro de Vitest mediante el servidor de Node.
VITE_USE_MOCKS=false
